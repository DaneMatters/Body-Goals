{
  "name": "body-goals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply body_goals_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply body_goals_db --remote",
    "db:seed:local": "wrangler d1 execute body_goals_db --local --file=./drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute body_goals_db --remote --file=./drizzle/seed.sql",
    "import:fitnotes": "tsx scripts/import-fitnotes.ts"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "drizzle-orm": "^0.38.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^0.1.16",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "csv-parse": "^5.6.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  }
}
